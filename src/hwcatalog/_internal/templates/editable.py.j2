{# Register an existing Git working copy as a Conan editable package. #}
from conan import ConanFile


class EditableRecord(ConanFile):
    name = {{ name | pyrepr }}
    version = {{ version | pyrepr }}

    def requirements(self):
        for reference in self.conan_data.get("requires", []):
            self.requires(reference)

    def layout(self):
        self.folders.source = {{ source | pyrepr }}
        self.cpp.source.srcdirs = ["."]
