from conan import ConanFile


class CatalogRecord(ConanFile):
    name = {{ name|pyrepr }}
    version = {{ version|pyrepr }}
    exports = "record.json"

    def requirements(self):
        for reference in self.conan_data.get("requires", []):
            self.requires(reference)

    def export(self):
        from pathlib import Path
        from conan.tools.scm import Git
        marker = Path(self.recipe_folder) / "source-path.txt"
        if marker.is_file():
            Git(self, marker.read_text()).coordinates_to_conandata(repository=True)

    def source(self):
        from conan.tools.scm import Git
        if self.conan_data.get("scm"):
            Git(self, "source").checkout_from_conandata_coordinates()

    def package(self):
        import os
        from conan.tools.files import copy
        copy(self, "*", src=os.path.join(self.source_folder, "artifacts"),
             dst=os.path.join(self.package_folder, "artifacts"))
