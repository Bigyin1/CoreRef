def make_route(modules: Iterable[str], variants: Iterable[str] = ()) -> Route:
    """Select and validate an available stage graph."""
    selected = {name: _SPECS[name] for module in modules for name in MODULES[module]}
    for variant in variants:
        for name, properties in _VARIANTS[variant].items():
            if name in selected:
                selected[name] = {**selected[name], **properties}
    return Route([StageSpec.model_validate({"name": name, **fields}) for name, fields in selected.items()])


def _stage(
    spec: StageSpec,
    transform: StageTransform | None,
    adapter: _Binder | None,
    files: Mapping[str, Path],
) -> Stage:
    stage = Stage(transform=transform) if adapter is None else adapter(spec, transform)
    settings = _PARAMETERS.get(spec.name)
    if not settings:
        return stage
    roles = settings.get("files", {})
    missing = set(roles.values()) - files.keys()
    if missing:
        raise ValueError(f"Stage {spec.name!r} needs file roles: {', '.join(sorted(missing))}")
    return replace(
        stage,
        files={**stage.files, **{name: files[role] for name, role in roles.items()}},
        configuration={**stage.configuration, **settings.get("configuration", {})},
        inputs=settings.get("inputs", stage.inputs),
        cache=settings.get("cache", stage.cache),
    )


def bind_stages(
    project: _Project,
    route: Route,
    *,
    files: Mapping[str, Path] | None = None,
) -> Mapping[str, Stage | Callable[[], Stage]]:
    """Bind only the stages selected for this project."""
    result: dict[str, Stage | Callable[[], Stage]] = {}
    adapters: dict[str, _Binder] = {}
    for name in route.order:
        transform, adapter = _HANDLERS[name]
        if adapter is not None and adapter not in adapters:
            adapters[adapter] = _ADAPTERS[adapter](project)
        binder = adapters[adapter] if adapter is not None else None
        result[name] = partial(_stage, route[name], transform, binder, files or {})
    return result
