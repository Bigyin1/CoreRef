{# Package a parameterized result using a standalone generator supplied by the flow. #}
import runpy
from pathlib import Path

from conan import ConanFile


class GeneratedPackage(ConanFile):
    name = {{ name | pyrepr }}
    version = {{ version | pyrepr }}
    revision_mode = "hash"
    options = {{ options | pyrepr }}
    default_options = {{ defaults | pyrepr }}
    exports_sources = "generator.py", "inputs/*"

    def source(self):
        (Path(self.source_folder) / "inputs").mkdir(exist_ok=True)

    def package(self):
        source = Path(self.source_folder)
        output = Path(self.package_folder)
        options = {name: str(self.options.get_safe(name)) for name in {{ options | list | pyrepr }}}
        output.mkdir(parents=True, exist_ok=True)
        runner = runpy.run_path(str(source / "generator.py"))
        runner["generate"](options, source / "inputs", output)
