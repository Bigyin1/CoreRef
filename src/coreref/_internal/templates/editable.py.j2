{# Expose an editable package through Conan alone; no generated metadata sidecars. #}
from conan import ConanFile


class EditableRecord(ConanFile):
    name = {{ name | pyrepr }}
    version = {{ version | pyrepr }}

    def init(self):
{% if manifest %}
        from pathlib import Path
        import yaml
        data = yaml.safe_load((Path(self.recipe_folder) / {{ manifest | pyrepr }}).read_text())
        self.conan_data = {
            "requires": data.get("dependencies", []),
            "record": {"format": {{ format }}, "ref": data["ref"],
                       "payload": data.get("payload"), "files": list(data.get("files", {}))},
            "source": ".",
            "files": data.get("files", {}),
        }
{% else %}
        self.conan_data = {{ data | pyrepr }}
{% endif %}

    def requirements(self):
        for reference in self.conan_data["requires"]:
            self.requires(reference)

    def layout(self):
        self.folders.source = self.conan_data["source"]
        self.folders.build = "artifacts"
        self.cpp.source.srcdirs = ["."]
